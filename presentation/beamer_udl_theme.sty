\usepackage{xcolor}

% ── Couleurs principales ─────────────────────────────────────────
\definecolor{UMCoral}{HTML}{E8524A}      % rouge-corail UM
\definecolor{MathBleu}{HTML}{2B3A6B}     % bleu marine Dpt Maths
\definecolor{MathOrange}{HTML}{5C6B7A}   % orange Dpt Maths
\definecolor{MathVert}{HTML}{6DB33F}     % vert Dpt Maths
\definecolor{MathCyan}{HTML}{3AAFE0}     % cyan Dpt Maths

% ── Neutres ──────────────────────────────────────────────────────
\definecolor{FondClair}{HTML}{F5F5F5}
\definecolor{FondSecondaire}{HTML}{E8E8E8}
\definecolor{GrisNeutre}{HTML}{BDC3CE}
\definecolor{NuitUM}{HTML}{1A1A2E}

% ── Thème Beamer ─────────────────────────────────────────────────
\setbeamercolor{palette primary}{bg=MathBleu, fg=white}
\setbeamercolor{palette secondary}{bg=UMCoral, fg=white}
\setbeamercolor{palette tertiary}{bg=MathOrange, fg=white}
\setbeamercolor{palette quaternary}{bg=NuitUM, fg=white}

\setbeamercolor{structure}{fg=MathBleu}
\setbeamercolor{frametitle}{bg=MathBleu, fg=white}
\setbeamercolor{title}{fg=MathBleu}
\setbeamercolor{subtitle}{fg=UMCoral}
\setbeamercolor{author}{fg=MathBleu}
\setbeamercolor{date}{fg=GrisNeutre}
\setbeamercolor{institute}{fg=MathBleu}

\setbeamercolor{block title}{bg=MathBleu, fg=white}
\setbeamercolor{block body}{bg=FondSecondaire, fg=NuitUM}

\setbeamercolor{block title alerted}{bg=UMCoral, fg=white}
\setbeamercolor{block body alerted}{bg=UMCoral!10, fg=NuitUM}

\setbeamercolor{block title example}{bg=MathVert, fg=white}
\setbeamercolor{block body example}{bg=MathVert!10, fg=NuitUM}

\setbeamercolor{itemize item}{fg=UMCoral}
\setbeamercolor{itemize subitem}{fg=MathOrange}
\setbeamercolor{itemize subsubitem}{fg=MathCyan}

\setbeamercolor{section in toc}{fg=MathBleu}
\setbeamercolor{footline}{bg=MathBleu, fg=white}

